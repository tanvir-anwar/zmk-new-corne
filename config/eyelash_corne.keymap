#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&caps_word {
    continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
};

&sk {
    quick-release;
};

/ {
    behaviors {
        ht: ht {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Hold Tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

    };

    macros {
        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(N4))>;
        };

    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    brightness_encoder: brightness_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&kp C_BRI_UP>, <&kp C_BRI_DN>;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };

        to_qwerty {
            bindings = <&to 1>;
            key-positions = <44 45>;
            layers = <0>;
        };

        to_colemak {
            bindings = <&to 0>;
            key-positions = <44 45>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "COLEMAK-DH";
            bindings = <
&kp GRAVE       &kp Q  &kp W  &kp F     &kp P     &kp B                            &kp UP               &kp J      &kp L        &kp U      &kp Y    &kp SEMI  &kp MINUS
&kp CAPS        &kp A          &kp R  &kp S     &kp T     &kp G                  &kp LEFT   &none    &kp RIGHT   &kp M      &kp N        &kp E      &kp I    &kp O     &kp SQT
&kp LALT  &ht LALT Z  &kp X  &kp C     &kp D     &kp V     &kp SPACE               &kp DOWN             &kp K      &kp H        &kp COMMA  &kp DOT  &ht RSHFT FSLH  &kp RSHFT
                              &ht LCMD TAB  &kp BSPC  &sk LSHFT                                           &lt 2 SPACE  &lt 3 ENTER  &ht RCTRL ESC
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        qwerty_layer {
            display-name = "QWERTY";
            bindings = <
&trans  &kp Q  &kp W  &kp E  &kp R  &kp T                       &trans                       &kp Y  &kp U  &kp I      &kp O    &kp P             &trans
&trans  &kp A  &kp S  &kp D  &kp F  &kp G             &trans  &trans  &trans             &kp H  &kp J  &kp K      &kp L    &kp SEMI          &trans
&trans  &ht LALT Z  &kp X  &kp C  &kp V  &kp B  &trans              &trans                       &kp N  &kp M  &kp COMMA  &kp DOT  &ht RSHFT FSLH  &trans
                              &trans  &trans  &trans                                           &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp N1     &kp N2    &kp N3    &kp N4    &kp N5                        &trans                     &kp N6       &kp N7     &kp N8    &kp N9     &kp N0   &trans
&trans  &kp GRAVE  &kp TILDE &kp LBKT  &kp LBRC  &kp LPAR          &trans  &trans  &trans              &kp PIPE     &kp MINUS  &kp EQUAL &kp DQT    &kp SQT  &trans
&trans  &trans     &trans    &kp RBKT  &kp RBRC  &kp RPAR  &trans           &trans                     &kp BSLH     &kp UNDER  &trans     &trans     &trans   &trans
                                      &trans    &trans  &trans                                                    &trans     &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        function_layer {
            display-name = "NAV/FN";
            bindings = <
&sys_reset      &kp TAB       &kp C_MUTE      &kp F3         &screenshot       &tog 2                                 &mmv MOVE_UP                     &trans       &mkp LCLK  &mkp RCLK  &trans     &kp MINUS  &bootloader
&bt BT_CLR_ALL  &kp CAPS      &sk LCTRL       &sk LALT       &sk LCMD          &caps_word              &mmv MOVE_LEFT  &mkp LCLK  &mmv MOVE_RIGHT  &kp LEFT     &kp DOWN    &kp UP     &kp RIGHT  &kp SQT    &trans
&soft_off       &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans                  &mmv MOVE_DOWN                   &kp PG_DN    &kp PG_UP   &trans     &trans     &trans     &trans
                                                &trans          &trans          &trans                                                        &trans       &trans      &trans
            >;

            sensor-bindings = <&brightness_encoder>;
        };
    };
};
