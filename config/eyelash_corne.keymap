#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        ht: ht {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Hold Tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        mo_tog: mo_tog {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Momentary/Toggle Layer Hold Tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&tog>;
        };
    };

    macros {
        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(N4))>;
        };

        cmd_click: cmd_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LGUI>,
                <&macro_tap &mkp LCLK>,
                <&macro_release &kp LGUI>;
            label = "CMD_CLICK";
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    brightness_encoder: brightness_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&kp C_BRI_UP>, <&kp C_BRI_DN>;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };

        to_colemak {
            bindings = <&to 3>;
            key-positions = <44 45>;
            layers = <0>;
        };

        to_qwerty {
            bindings = <&to 0>;
            key-positions = <44 45>;
            layers = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB         &kp Q  &kp W  &kp E     &kp R     &kp T                            &kp UP               &kp Y      &kp U        &kp I      &kp O    &kp P     &kp MINUS
&ht GLOBE BSLH  &kp A  &kp S  &kp D     &kp F     &kp G                  &kp LEFT   &none    &kp RIGHT   &kp H      &kp J        &kp K      &kp L    &kp SEMI  &kp SQT
&ht LALT EQUAL  &kp Z  &kp X  &kp C     &kp V     &kp B     &kp SPACE               &kp DOWN             &kp N      &kp M        &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                              &kp BSPC  &kp LCMD  &mo_tog 1 1                                            &kp SPACE  &lt 2 ENTER  &ht RCTRL ESC
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
&kp GRAVE   &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT                            &kp UP                        &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &trans
&trans      &kp N1    &kp N2  &kp N3    &kp N4    &kp N5               &kp LEFT         &none         &kp RIGHT       &kp N6     &kp N7     &kp N8     &kp N9    &kp N0    &trans
&trans      &trans    &trans  &trans    &trans    &trans    &trans                     &kp DOWN                      &kp LBKT   &kp RBKT   &trans     &trans     &trans     &trans
                              &trans    &trans     &trans                                                           &trans     &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        function_layer {
            display-name = "FUNC";
            bindings = <
&kp TILDE  &kp TAB       &kp C_MUTE      &kp F3         &screenshot  &trans                                    &mmv MOVE_UP                  &trans          &trans         &trans         &trans         &trans     &bootloader
&bt BT_CLR_ALL  &kp ESC  &bt BT_SEL 0    &bt BT_SEL 1   &bt BT_SEL 2 &out OUT_USB            &mmv MOVE_LEFT  &mkp LCLK      &mmv MOVE_RIGHT &kp LEFT        &kp DOWN       &kp UP         &kp RIGHT      &mkp LCLK  &mkp RCLK
&trans  &rgb_ug RGB_OFF &rgb_ug RGB_ON  &rgb_ug RGB_EFF &sys_reset   &soft_off  &trans                       &mmv MOVE_DOWN                &kp LG(LEFT)    &kp PG_DN      &kp PG_UP      &kp LG(RIGHT)  &cmd_click &trans
                                        &trans          &trans       &trans                                                                 &trans          &trans         &trans
            >;

            sensor-bindings = <&brightness_encoder>;
        };

        colemak_layer {
            display-name = "COLEMAK-DH";
            bindings = <
&trans             &kp Q          &kp W        &kp F       &kp P  &kp B                             &kp UP               &kp J      &kp L          &kp U        &kp Y        &kp SQT         &trans
&trans             &kp A          &kp R        &kp S       &kp T  &kp G                  &kp LEFT    &none    &kp RIGHT  &kp M      &kp N          &kp E        &kp I        &kp O           &trans
&trans             &ht LSHIFT Z   &ht LCTRL X  &ht LALT C  &kp D  &kp V  &kp SPACE                  &kp DOWN             &kp K      &kp H          &ht RALT COMMA  &ht RCTRL DOT  &ht RSHIFT FSLH  &trans
                                                &kp BSPC    &ht LCMD TAB  &mo_tog 4 4                                      &kp SPACE  &lt 4 ENTER  &ht RCTRL ESC
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        symbol_dh_layer {
            display-name = "SYMBOL-DH";
            bindings = <
&trans             &kp N1          &kp N2     &kp N3       &kp N4    &kp N5                            &mmv MOVE_UP                  &kp N6      &kp N7      &kp N8        &kp N9       &kp N0          &trans
&trans             &kp GRAVE       &kp TILDE  &kp MINUS    &kp EQUAL &kp GLOBE             &mmv MOVE_LEFT  &mkp LCLK  &mmv MOVE_RIGHT  &kp LEFT    &kp DOWN    &kp UP        &kp RIGHT    &kp SEMI        &trans
&trans             &ht LSHIFT BSLH &kp COLON  &caps_word   &kp LBKT  &kp RBKT  &trans                   &mmv MOVE_DOWN                &kp PG_DN   &kp PG_UP   &kp COMMA     &kp DOT      &ht RSHIFT FSLH &trans
                                                   &kp BSPC  &ht LCMD TAB  &trans                                                       &kp SPACE   &kp ENTER   &ht RCTRL ESC
            >;

            sensor-bindings = <&brightness_encoder>;
        };
    };
};
